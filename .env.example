# App
APP_NAME=world-watcher
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-on-first-run

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Database
SQLITE_PATH=data/world_watcher.db

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
LOCAL_AI_BASE_URL=http://localhost:11434/v1
LOCAL_AI_MODEL=llama3.1

# Alerts / Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Voice
WHISPER_MODEL=small
TTS_PROVIDER=edge-tts
DEFAULT_VOICE_GENDER=female
VOICE_VAD_THRESHOLD=0.02
VOICE_SILENCE_MS=700
VOICE_MAX_UTTERANCE_S=20

# Workers
USER_AGENT=world-watcher/0.1 (+https://localhost)
RATE_LIMIT_PER_HOST_PER_SEC=1
WORKER_MAX_CONCURRENCY=20
WORKER_MAX_RETRIES=3
WORKER_JOB_TIMEOUT_SECONDS=60
MOCK_MODE=true
NEWS_RSS_URLS=https://hnrss.org/frontpage
PRICE_SYMBOLS=bitcoin:usd
WATCH_URLS=https://example.com
POLL_INTERVAL_SECONDS=60
